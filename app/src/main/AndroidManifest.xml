<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Health ConnectアプリのPackageManager可視性（Android 11+のパッケージ可視性制限）。 -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <!-- DataOriginのアプリ名解決（PackageManager経由、healthconnect/DataOriginNameResolver.kt）用。
             権限説明画面（下記intent-filter）の動作には影響しない（実機確認、2026-09-29。<queries>を
             外しても権限ダイアログは正常に開いた。<queries>は自分が他アプリを見るための宣言であり、
             Health Connect側が自分のintent-filterを見つけられるかどうかとは別の仕組みのため）。
             同じandroidx.health.ACTION_SHOW_PERMISSIONS_RATIONALEをHealth Connect連携先アプリの多くが
             実装しているため、Android 11+のパッケージ可視性制限下でも解決できている（lessons.md 6.4）。 -->
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HealthDataViewer">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.HealthDataViewer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Health Connectの権限ダイアログの「プライバシーポリシー」リンクから起動される（lessons.md 2.1）。
                 この宣言がないと、Health Connect側が権限リクエスト自体を拒否する（PermissionsActivityが
                 "App should support rationale intent" で即終了する。2026-09-29実機確認）。 -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>

            <!-- Android 14以降向けの同用途の宣言。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity>
    </application>

</manifest>
