<?xml version="1.0" encoding="utf-8"?>
<!--
   DataStore（テーマ・表示指標、WBS 6.6で導入。要件§21）は健康データを含まない
   ため、バックアップ対象のままでよい（除外不要）。言語はAppCompatDelegateが
   自前で永続化するためこのアプリのDataStoreには含まれない。
   将来のデータ追加時の方針（backup_rules.xmlと共通）:
   -   購入状態キャッシュ（WBS 7.4）も同じ理由でDataStoreのまま除外不要の想定
   -   Room（健康データのキャッシュ、PoC 4.3で要否判断）を導入する場合は、
       cloud-backup・device-transferの両方から必ず除外する。健康データを
       Googleドライブ等へ自動バックアップしないため（要件§14）
-->
<data-extraction-rules>
    <cloud-backup>
    </cloud-backup>
</data-extraction-rules>
