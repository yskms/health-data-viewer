<?xml version="1.0" encoding="utf-8"?>
<!--
   現時点でアプリ独自の永続データがないため除外ルールは未定義。
   将来のデータ追加時の方針（backup_rules.xmlと共通）:
   -   DataStore（テーマ・言語・表示指標・購入状態キャッシュ、要件§21）は
       健康データを含まないため、バックアップ対象のままでよい（除外不要）
   -   Room（健康データのキャッシュ、PoC 4.3で要否判断）を導入する場合は、
       cloud-backup・device-transferの両方から必ず除外する。健康データを
       Googleドライブ等へ自動バックアップしないため（要件§14）
-->
<data-extraction-rules>
    <cloud-backup>
    </cloud-backup>
</data-extraction-rules>
